<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Loja Online - Streetwear & Co.</title>
    <!-- Tailwind CSS para design moderno -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- EmailJS para envio de e-mails -->
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"></script>
    <script type="text/javascript">
        (function() {
            emailjs.init("YOUR_PUBLIC_KEY"); // Substitui pela tua chave pública do EmailJS
        })();
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
    </style>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen flex flex-col">

    <!-- HEADER -->
    <header class="sticky top-0 z-40 bg-slate-900/80 backdrop-blur-md border-b border-slate-800">
        <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <span class="text-2xl font-black tracking-tighter bg-gradient-to-r from-indigo-500 to-rose-500 bg-clip-text text-transparent">STREET.PT</span>
            </div>
            <button onclick="toggleCart()" class="relative bg-slate-800 hover:bg-slate-700 p-2.5 rounded-xl transition flex items-center space-x-2 border border-slate-700">
                <svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                <span class="text-sm font-bold" id="cart-count">0</span>
            </button>
        </div>
    </header>

    <!-- HERO SECTION -->
    <section class="relative py-12 px-4 bg-gradient-to-b from-indigo-950/40 to-slate-950 border-b border-slate-900">
        <div class="max-w-4xl mx-auto text-center space-y-4">
            <span class="bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">Nova Coleção 2026</span>
            <h1 class="text-4xl md:text-5xl font-black tracking-tight">Estilo Urbano & Exclusivo</h1>
            <p class="text-slate-400 text-sm md:text-base max-w-xl mx-auto">Equipamentos e vestuário de alta qualidade com envio rápido para todo o país.</p>
        </div>
    </section>

    <!-- CATALOGO -->
    <main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full">
        <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-bold">Produtos Disponíveis</h2>
            <div class="text-xs text-slate-400">Pagamento seguro por Revolut & MB WAY</div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" id="product-grid">
            <!-- Produtos gerados via JS -->
        </div>
    </main>

    <!-- CARRINHO LATERAL / MODAL -->
    <div id="cart-modal" class="fixed inset-0 z-50 bg-black/70 backdrop-blur-sm hidden flex justify-end">
        <div class="bg-slate-900 w-full max-w-md h-full flex flex-col border-l border-slate-800 shadow-2xl">
            <div class="p-4 border-b border-slate-800 flex items-center justify-between">
                <h3 class="font-bold text-lg">O teu Carrinho</h3>
                <button onclick="toggleCart()" class="text-slate-400 hover:text-white p-2">✕</button>
            </div>
            <div id="cart-items" class="flex-grow overflow-y-auto p-4 space-y-4 divide-y divide-slate-800/50">
                <!-- Itens adicionados -->
            </div>
            <div class="p-4 border-t border-slate-800 bg-slate-950/50 space-y-3">
                <div class="flex justify-between text-base font-bold">
                    <span>Total:</span>
                    <span id="cart-total" class="text-indigo-400">0.00 €</span>
                </div>
                <button onclick="openCheckout()" class="w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold py-3.5 rounded-xl transition shadow-lg shadow-indigo-600/25">
                    Avançar para Envio e Pagamento
                </button>
            </div>
        </div>
    </div>

    <!-- MODAL DE CHECKOUT E PAGAMENTO -->
    <div id="checkout-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-md hidden flex items-center justify-center p-4">
        <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto p-6 space-y-6 shadow-2xl">
            <div class="flex justify-between items-center border-b border-slate-800 pb-4">
                <h3 class="text-lg font-bold">Dados de Envio & Pagamento</h3>
                <button onclick="closeCheckout()" class="text-slate-400 hover:text-white">✕</button>
            </div>

            <!-- Formulário de Morada -->
            <form id="order-form" onsubmit="processPayment(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1">Nome Completo</label>
                    <input type="text" id="cust-name" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-indigo-500" placeholder="Teu nome">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1">E-mail (para receber o recibo)</label>
                    <input type="email" id="cust-email" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-indigo-500" placeholder="exemplo@gmail.com">
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">Telemóvel</label>
                        <input type="tel" id="cust-phone" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-indigo-500" placeholder="912345678">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-400 mb-1">Código Postal</label>
                        <input type="text" id="cust-zip" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-indigo-500" placeholder="0000-000">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-400 mb-1">Morada de Entrega</label>
                    <input type="text" id="cust-address" required class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:border-indigo-500" placeholder="Rua, Número, Andar">
                </div>

                <!-- Escolha de Pagamento -->
                <div class="pt-2">
                    <label class="block text-xs font-semibold text-slate-400 mb-2">Método de Pagamento</label>
                    <div class="grid grid-cols-2 gap-3">
                        <label class="border border-slate-800 bg-slate-950 p-3 rounded-xl flex items-center space-x-3 cursor-pointer hover:border-indigo-500 transition">
                            <input type="radio" name="pay-method" value="revolut" checked onchange="togglePaymentMethod('revolut')">
                            <span class="text-sm font-bold">Revolut</span>
                        </label>
                        <label class="border border-slate-800 bg-slate-950 p-3 rounded-xl flex items-center space-x-3 cursor-pointer hover:border-indigo-500 transition">
                            <input type="radio" name="pay-method" value="mbway" onchange="togglePaymentMethod('mbway')">
                            <span class="text-sm font-bold">MB WAY</span>
                        </label>
                    </div>
                </div>

                <!-- Detalhes Revolut -->
                <div id="revolut-box" class="bg-indigo-950/20 border border-indigo-900/40 p-4 rounded-xl space-y-2">
                    <p class="text-xs text-indigo-300">Transfere o valor total para a Revtag:</p>
                    <div class="flex items-center justify-between bg-slate-950 px-3 py-2 rounded-lg border border-slate-800">
                        <span class="font-mono text-indigo-400 font-bold" id="revtag-text">@joaocarvalho3051974</span>
                        <button type="button" onclick="copyRev
